# Database Configuration (SQLite Local Development)
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET="YOUR_JWT_SECRET_KEY_HERE"
NEXTAUTH_SECRET="YOUR_NEXTAUTH_SECRET_KEY_HERE"
NEXTAUTH_URL="http://localhost:3000"

# Application Base URL & Integrations
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/leadpoint-sales-demo/20min"

# Calendly API v2 Provider Configuration ("mock" | "real")
CALENDLY_PROVIDER="mock"
CALENDLY_ACCESS_TOKEN="YOUR_CALENDLY_PERSONAL_ACCESS_TOKEN"
CALENDLY_WEBHOOK_SIGNING_KEY="YOUR_CALENDLY_WEBHOOK_SIGNING_KEY"
CALENDLY_WEBHOOK_URL="http://localhost:3000/api/webhooks/calendly"

# Internationalization
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,es,de,hi,fr"

# Telephony Provider Configuration ("mock" | "twilio")
TELEPHONY_PROVIDER="mock"
TWILIO_VOICE_NUMBER="+18005550199"
TWILIO_VOICE_WEBHOOK_URL="https://YOUR_PUBLIC_DOMAIN/api/voice/twilio/answer"
TWILIO_VOICE_STATUS_WEBHOOK_URL="https://YOUR_PUBLIC_DOMAIN/api/voice/twilio/status"

# AI Voice Provider Configuration ("mock" | "real")
AI_VOICE_PROVIDER="mock"
AI_VOICE_API_KEY="YOUR_AI_VOICE_API_KEY"

# SMS Dispatch Provider Configuration ("mock" | "twilio")
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_API_KEY="YOUR_TWILIO_API_KEY"
TWILIO_API_SECRET="YOUR_TWILIO_API_SECRET"
TWILIO_PHONE_NUMBER="+18005550199"

# Lead Enrichment & Social Sourcing API Keys
LINKEDIN_SCRAPER_API_KEY="YOUR_LINKEDIN_API_KEY"
