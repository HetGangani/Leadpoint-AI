# ==============================================================================
# LeadPoint-AI Enterprise Platform Environment Configuration
# Copy this file to .env or .env.local for local development / deployment setup
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Connection Settings
# SQLite local path or PostgreSQL production connection string
# Examples:
#   SQLite: "file:./dev.db"
#   PostgreSQL: "postgresql://postgres:password@localhost:5432/leadpoint_db?schema=public"
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# Authentication & Access Control (JWT Security)
# Required for signing JWT auth tokens and user sessions
# Generate robust key: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET="leadpoint-super-secret-jwt-key-change-in-production-2026"
NEXTAUTH_SECRET="leadpoint-nextauth-secret-key-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Application Base URLs & Public Endpoints
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Internationalization & Locales (Next-Intl)
# Supported locales: en (English), es (Spanish), de (German), hi (Hindi), fr (French)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,es,de,hi,fr"

# ------------------------------------------------------------------------------
# AI Voice Agent & Telephony Provider Integrations
# Active Provider Options: "vapi" | "retell" | "twilio" | "mock"
# ------------------------------------------------------------------------------
TELEPHONY_PROVIDER="vapi"
VAPI_API_KEY="vapi_mock_sk_live_998877665544332211"
RETELL_API_KEY="retell_mock_key_001122334455"
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid_12345"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token_67890"

# ------------------------------------------------------------------------------
# Lead Discovery & Data Enrichment API Providers
# ------------------------------------------------------------------------------
LINKEDIN_SCRAPER_API_KEY="likd_mock_key_9876543210"
X_TWITTER_API_BEARER_TOKEN="AAAA_mock_x_twitter_bearer_token_xyz"
CLEARBIT_API_KEY="sk_mock_clearbit_api_key_1122"
APOLLO_API_KEY="apollo_mock_api_key_3344"
